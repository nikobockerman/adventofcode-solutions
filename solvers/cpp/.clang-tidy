---
Checks: >-
  bugprone-*,
  cert-*, -cert-err58-cpp,
  clang-analyzer-*,
  clang-diagnostic-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  hicpp-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*, -portability-avoid-pragma-once,
  readability-*, -readability-identifier-length,
  -bugprone-exception-escape,
  -google-readability-todo,
  -misc-const-correctness,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -readability-trailing-comma
CheckOptions:
  cppcoreguidelines-avoid-do-while.IgnoreMacros: "true"
  cppcoreguidelines-macro-usage.AllowedRegexp: "^ASSERT_HAS_VALUE"
  modernize-use-ranges.IncludeStyle: "google"
  modernize-use-trailing-return-type.TransformLambdas: "all_except_auto"
  readability-function-cognitive-complexity.IgnoreMacros: true
WarningsAsErrors: "*"
HeaderFilterRegex: ".*"
